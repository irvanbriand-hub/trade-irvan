# Trading Journal — Environment Variables Template
# Copy file ini ke .env.local dan isi nilainya.
# Dapatkan semua nilai dari: Supabase Dashboard → Project Settings → API

# Supabase Project URL
VITE_SUPABASE_URL=https://<project-id>.supabase.co

# Supabase Anon/Public Key (BUKAN service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase Project ID (bagian dari URL)
VITE_SUPABASE_PROJECT_ID=<project-id>
