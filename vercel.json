{
  "crons": [
    {
      "path": "/api/noc-snapshot",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/telegram-webhook.ts": {
      "maxDuration": 60
    },
    "api/noc-snapshot.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
